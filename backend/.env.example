# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- JazzCash sandbox (get these from https://sandbox.jazzcash.com.pk merchant portal) ---
# Leave blank to use the built-in MOCK checkout (works offline, same hash logic).
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_POST_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/

# --- OpenSky (optional; anonymous works but is rate limited) ---
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# --- Flight data: Duffel test mode (free). Sign up at https://duffel.com, copy a *test* token (duffel_test_...).
# Leave blank to use the built-in offline demo provider.
DUFFEL_API_KEY=

# --- FX to PKR (JazzCash charges in PKR; Duffel prices are in USD/GBP/...) ---
FX_USD_PKR=280
FX_GBP_PKR=355
FX_EUR_PKR=305

# --- Auth ---
SECRET_KEY=change-me-to-a-long-random-string

# --- Confirmation email (optional). Without SMTP, emails are saved to backend/outbox/ ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SkyAgent <no-reply@skyagent.local>
